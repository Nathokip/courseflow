generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String
  studentId     String         @unique
  role          String         @default("student")
  semester      String         @default("Spring 2025")
  avatarUrl     String         @default("")
  registeredCredits Int       @default(0)
  maxCredits    Int            @default(18)
  creditLimit   Int            @default(18)
  registrationDeadline String  @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  accounts      Account[]
  sessions      Session[]
  registrations Registration[]
  cartItems     CartItem[]
  passwordResetTokens PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Course {
  id            String         @id @default(cuid())
  code          String
  name          String
  description   String
  credits       Int
  instructor    String
  schedule      String
  department    String
  semester      String
  year          Int            @default(1)
  enrolled      Int            @default(0)
  capacity      Int
  colorVariant  String         @default("primary")
  createdAt     DateTime       @default(now())

  registrations Registration[]
  cartItems     CartItem[]
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  icon      String
  iconColor String
  createdAt DateTime @default(now())
}

model Registration {
  id        String   @id @default(cuid())
  userId    String
  courseId   String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  courseId   String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
